generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------------------
// FUEL TYPES & PRICING
// --------------------------------------------------

model FuelType {
  id            Int            @id @default(autoincrement())
  name          String
  code          String         @unique
  prices        FuelPrice[]
  tanks         Tank[]
  orders        FuelOrder[]
  sellingPrices SellingPrice[]
  orderQuotes   OrderQuote[]

  @@map("fuel_types")
}

model FuelPrice {
  id                Int       @id @default(autoincrement())
  fuelTypeId        Int       @map("fuel_type_id")
  priceMinor        Int?      @map("price_minor")
  currency          String    @db.VarChar(3)
  source            String?
  fetchedAt         DateTime  @default(now()) @map("fetched_at")
  // Legacy amounts retain their original integer semantics; never infer their unit/market.
  provenance        String    @default("legacy")
  provider          String?   @db.VarChar(32)
  market            String?   @db.VarChar(2)
  fuelCode          String?   @map("fuel_code") @db.VarChar(64)
  price             Decimal?  @db.Decimal(32, 14)
  providerFuelCode  String?   @map("provider_fuel_code") @db.VarChar(64)
  providerPrice     Decimal?  @map("provider_price") @db.Decimal(30, 12)
  providerUnit      String?   @map("provider_unit") @db.VarChar(16)
  conversionDivisor Int?      @map("conversion_divisor")
  unit              String?   @db.VarChar(16)
  effectiveAt       DateTime? @map("effective_at") @db.Date
  seriesKey         String?   @map("series_key") @db.VarChar(256)
  providerSeriesId  String?   @map("provider_series_id") @db.VarChar(240)
  kind              String?   @db.VarChar(16)
  interval          String?   @db.VarChar(16)
  freshness         String?   @db.VarChar(64)
  lastSeenAt        DateTime? @map("last_seen_at")

  fuelType FuelType @relation(fields: [fuelTypeId], references: [id], onDelete: Restrict)

  @@unique([provider, market, fuelCode, seriesKey, currency, unit, effectiveAt, price], map: "fuel_prices_quote_identity")
  @@index([fuelTypeId, fetchedAt])
  @@index([provider, market, effectiveAt])
  @@map("fuel_prices")
}

// One atomic, cross-process cooldown claim per provider/market. No network transaction.
model FuelPriceRefresh {
  key           String   @id
  nextAllowedAt DateTime @map("next_allowed_at")

  @@map("fuel_price_refreshes")
}

// Admin-authored global selling tariffs. Rows are appended, never overwritten.
model SellingPrice {
  id             Int          @id @default(autoincrement())
  fuelTypeId     Int          @map("fuel_type_id")
  currency       String       @db.VarChar(3)
  unitPriceMinor Int          @map("unit_price_minor")
  effectiveAt    DateTime     @map("effective_at") @db.Timestamptz(3)
  createdBy      Int          @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  fuelType       FuelType     @relation(fields: [fuelTypeId], references: [id], onDelete: Restrict)
  creator        User         @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  quotes         OrderQuote[]

  @@unique([fuelTypeId, currency, effectiveAt])
  @@map("selling_prices")
}

model OrderQuote {
  id              String       @id @default(uuid()) @db.Uuid
  stationId       Int          @map("station_id")
  fuelTypeId      Int          @map("fuel_type_id")
  sellingPriceId  Int          @map("selling_price_id")
  customerId      Int?         @map("customer_id")
  guestTokenHash  String?      @map("guest_token_hash") @db.Char(64)
  fulfillmentType String       @map("fulfillment_type")
  currency        String       @db.VarChar(3)
  unitPriceMinor  Int          @map("unit_price_minor")
  quantity        Decimal      @db.Decimal(12, 3)
  totalMinor      Int          @map("total_minor")
  inputMode       String       @map("input_mode")
  requestedValue  String       @map("requested_value") @db.VarChar(32)
  expiresAt       DateTime     @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  station         Station      @relation(fields: [stationId], references: [id], onDelete: Restrict)
  fuelType        FuelType     @relation(fields: [fuelTypeId], references: [id], onDelete: Restrict)
  sellingPrice    SellingPrice @relation(fields: [sellingPriceId], references: [id], onDelete: Restrict)
  customer        User?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order           FuelOrder?

  @@index([expiresAt])
  @@map("order_quotes")
}

// --------------------------------------------------
// STATIONS & USERS
// --------------------------------------------------

model Station {
  id            Int      @id @default(autoincrement())
  name          String
  isActive      Boolean  @default(true) @map("is_active")
  address       String?
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  managerId     Int?     @unique @map("manager_id")
  deviceKeyHash String?  @unique @map("device_key_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  manager      User?              @relation("StationManager", fields: [managerId], references: [id], onDelete: SetNull)
  users        User[]             @relation("UserStation")
  tanks        Tank[]
  pumps        Pump[]
  orders       FuelOrder[]
  orderQuotes  OrderQuote[]
  callSessions CallSession[]
  shifts       Shift[]
  attendance   AttendanceRecord[]

  @@map("stations")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  tokenVersion Int      @default(0) @map("token_version")
  roleId       Int      @map("role_id")
  stationId    Int?     @map("station_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role                Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  station             Station?           @relation("UserStation", fields: [stationId], references: [id], onDelete: SetNull)
  managedStation      Station?           @relation("StationManager")
  customerOrders      FuelOrder[]        @relation("OrderCustomer")
  createdOrders       FuelOrder[]        @relation("OrderCreator")
  assignedOrders      FuelOrder[]        @relation("OrderAssignee")
  orderEvents         OrderEvent[]       @relation("OrderEventActor")
  handledCallSessions CallSession[]      @relation("CallSessionHandoff")
  refreshSessions     RefreshSession[]
  shifts              Shift[]
  attendance          AttendanceRecord[]
  sellingPrices       SellingPrice[]
  orderQuotes         OrderQuote[]
  confirmedPayments   Payment[]          @relation("PaymentConfirmer")

  @@index([roleId])
  @@index([stationId])
  @@map("users")
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

// Planned work and actual attendance are independent records. Their station
// reflects where work was recorded, not the employee's current assignment.
model Shift {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  stationId  Int      @map("station_id")
  startsAt   DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  employee User    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  station  Station @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@index([startsAt, id])
  @@index([stationId, startsAt])
  @@index([employeeId, startsAt])
  @@map("shifts")
}

model AttendanceRecord {
  // One open record per employee is enforced by the partial index in SQL.
  checkInRequestId String?   @map("check_in_request_id") @db.Uuid
  id               Int       @id @default(autoincrement())
  employeeId       Int       @map("employee_id")
  stationId        Int       @map("station_id")
  clockInAt        DateTime  @map("clock_in_at") @db.Timestamptz(3)
  clockOutAt       DateTime? @map("clock_out_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  employee User    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  station  Station @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@unique([employeeId, checkInRequestId], map: "attendance_employee_request_key")
  @@index([clockInAt, id])
  @@index([stationId, clockInAt])
  @@index([employeeId, clockInAt])
  @@map("attendance_records")
}

model Permission {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

// --------------------------------------------------
// FUEL INVENTORY & SENSORS
// --------------------------------------------------

model Tank {
  id                 Int     @id @default(autoincrement())
  stationId          Int     @map("station_id")
  fuelTypeId         Int     @map("fuel_type_id")
  capacityLiters     Decimal @map("capacity_liters") @db.Decimal(12, 3)
  lowThresholdLiters Decimal @map("low_threshold_liters") @db.Decimal(12, 3)

  station        Station         @relation(fields: [stationId], references: [id], onDelete: Restrict)
  fuelType       FuelType        @relation(fields: [fuelTypeId], references: [id], onDelete: Restrict)
  sensorReadings SensorReading[]

  @@index([stationId])
  @@index([fuelTypeId])
  @@map("tanks")
}

model SensorReading {
  id          Int      @id @default(autoincrement())
  tankId      Int      @map("tank_id")
  levelLiters Decimal  @map("level_liters") @db.Decimal(12, 3)
  recordedAt  DateTime @default(now()) @map("recorded_at")

  tank Tank @relation(fields: [tankId], references: [id], onDelete: Restrict)

  @@index([tankId, recordedAt])
  @@map("sensor_readings")
}

// --------------------------------------------------
// PUMPS
// --------------------------------------------------

model Pump {
  id        Int    @id @default(autoincrement())
  stationId Int    @map("station_id")
  number    Int
  status    String

  station Station     @relation(fields: [stationId], references: [id], onDelete: Restrict)
  orders  FuelOrder[]

  @@unique([stationId, number])
  @@map("pumps")
}

// --------------------------------------------------
// ORDERS & ORDER HISTORY
// --------------------------------------------------

model FuelOrder {
  id                  Int       @id @default(autoincrement())
  stationId           Int       @map("station_id")
  pumpId              Int?      @map("pump_id")
  // Nullable additions preserve the unknown meaning of legacy monetary values.
  currency            String?   @db.VarChar(3)
  fulfillmentType     String?   @map("fulfillment_type")
  quoteId             String?   @unique @map("quote_id") @db.Uuid
  creationKey         String?   @unique @map("creation_key") @db.Uuid
  creationRequestHash String?   @map("creation_request_hash") @db.Char(64)
  userId              Int?      @map("user_id")
  createdBy           Int?      @map("created_by")
  assignedEmployeeId  Int?      @map("assigned_employee_id")
  claimedAt           DateTime? @map("claimed_at") @db.Timestamptz(3)
  fuelTypeId          Int       @map("fuel_type_id")
  source              String
  status              String
  unitPriceMinor      Int       @map("unit_price_minor")
  orderedVolume       Decimal   @map("ordered_volume") @db.Decimal(12, 3)
  orderedAmountMinor  Int       @map("ordered_amount_minor")
  dispensedVolume     Decimal?  @map("dispensed_volume") @db.Decimal(12, 3)
  finalMinor          Int?      @map("final_minor")
  customerName        String?   @map("customer_name")
  customerPhone       String?   @map("customer_phone")
  scheduledFor        DateTime? @map("scheduled_for")
  notes               String?
  expiresAt           DateTime? @map("expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  station      Station       @relation(fields: [stationId], references: [id], onDelete: Restrict)
  pump         Pump?         @relation(fields: [pumpId], references: [id], onDelete: Restrict)
  quote        OrderQuote?   @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  user         User?         @relation("OrderCustomer", fields: [userId], references: [id], onDelete: SetNull)
  creator      User?         @relation("OrderCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  assignee     User?         @relation("OrderAssignee", fields: [assignedEmployeeId], references: [id], onDelete: Restrict)
  fuelType     FuelType      @relation(fields: [fuelTypeId], references: [id], onDelete: Restrict)
  events       OrderEvent[]
  payments     Payment[]
  callSessions CallSession[]

  @@index([stationId, status])
  @@index([assignedEmployeeId, stationId, status])
  // One PENDING/IN_PROGRESS order per pump is enforced by a partial SQL index.
  @@index([pumpId])
  @@index([userId])
  @@index([fuelTypeId])
  @@index([createdAt])
  @@map("orders")
}

model OrderEvent {
  id          Int      @id @default(autoincrement())
  orderId     Int      @map("order_id")
  actorUserId Int?     @map("actor_user_id")
  actorType   String   @map("actor_type")
  fromStatus  String?  @map("from_status")
  toStatus    String   @map("to_status")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  order FuelOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor User?     @relation("OrderEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([actorUserId])
  @@map("order_events")
}

// --------------------------------------------------
// PAYMENTS
// --------------------------------------------------

model Payment {
  id            Int      @id @default(autoincrement())
  orderId       Int      @map("order_id")
  method        String
  provider      String?
  currency      String   @db.VarChar(3)
  amountMinor   Int      @map("amount_minor")
  capturedMinor Int      @default(0) @map("captured_minor")
  status        String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  confirmedById Int?      @map("confirmed_by_id")
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz(3)
  confirmer     User?     @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  order         FuelOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  // Partial unique index for confirmed cash payments is defined in the SQL migration.
  @@index([confirmedById])
  @@index([orderId])
  @@map("payments")
}

// --------------------------------------------------
// AI VOICE CALL SESSIONS
// --------------------------------------------------

model CallSession {
  id            Int       @id @default(autoincrement())
  stationId     Int       @map("station_id")
  orderId       Int?      @map("order_id")
  handoffUserId Int?      @map("handoff_user_id")
  phone         String?
  outcome       String?
  transcript    String?
  extractedData Json?     @map("extracted_data")
  confidence    Decimal?  @db.Decimal(5, 4)
  startedAt     DateTime  @default(now()) @map("started_at")
  endedAt       DateTime? @map("ended_at")

  station     Station    @relation(fields: [stationId], references: [id], onDelete: Restrict)
  order       FuelOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  handoffUser User?      @relation("CallSessionHandoff", fields: [handoffUserId], references: [id], onDelete: SetNull)

  @@index([stationId, startedAt])
  @@index([orderId])
  @@map("call_sessions")
}
