{
  "name": "smart-fuel-station",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev --workspace @smart-fuel-station/api\" \"npm run dev --workspace @smart-fuel-station/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "concurrently": "^9.1.2",
    "prisma": "^7.10.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1"
  }
}
