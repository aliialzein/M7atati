{
  "name": "smart-fuel-station",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev --workspace @smart-fuel-station/api\" \"npm run dev --workspace @smart-fuel-station/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
